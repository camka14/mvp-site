          }
        },
        "listUrl": "https://www.portlandsoftball.com/current-programs",
        "itemSelector": ".row:has(img.programImage)"
      },
      "notes": "Extracts TeamSideline current-program rows and resolves More Info postback URLs."
    }
  }
