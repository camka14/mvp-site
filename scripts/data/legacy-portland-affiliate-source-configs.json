          },
          "venueName": {
            "mode": "literal",
            "value": "Portland Metro Softball Association",
            "selector": ":scope"
          },
          "statusText": {
            "selector": "[id$=\"_RegistrationStatusLabel\"]"
          },
          "description": {
            "selector": ".col-lg-8",
            "excludeSelectors": [
              "[id$=\"_ProgramNameLabel\"]",
              ".RadButton",
              "[id$=\"_RegistrationInfoPanel\"]",
              "[id*=\"Registration\"]",
              "[id$=\"_ProgramDurationLabel\"]",
              "[id$=\"_RegularRegistrationCostLabel\"]"
            ]
          },
          "scheduleText": {
            "selector": "[id$=\"_ProgramDurationLabel\"]"
          },
          "organizerName": {
            "mode": "literal",
            "value": "Portland Metro Softball Association",
            "selector": ":scope"
          },
          "officialActionUrl": {
            "mode": "attribute",
            "required": true,
            "selector": "[id$=\"_MoreButton\"]",
            "attribute": "id",
            "transform": "telerikPostBackUrl"
          },
          "participantOptionsText": {
            "selector": ".col-lg-8",
            "excludeSelectors": [
              "[id$=\"_ProgramNameLabel\"]",
              ".RadButton",
              "[id$=\"_RegistrationInfoPanel\"]",
              "[id*=\"Registration\"]",
              "[id$=\"_ProgramDurationLabel\"]",
              "[id$=\"_RegularRegistrationCostLabel\"]"
            ]
          },
          "registrationDeadlineText": {
