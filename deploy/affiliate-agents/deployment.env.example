AFFILIATE_AGENT_IMAGE=bracketiq-codex-affiliate-goal:0.146.0
AFFILIATE_AGENT_USER=1001:1001
AFFILIATE_AGENT_ROOT=/home/bracketiq
AFFILIATE_AGENT_ENV_FILE=/home/bracketiq/.config/bracketiq-affiliate-codex/container.env
AFFILIATE_AGENT_RESTART_POLICY=no

AFFILIATE_MAPPER_CPU_LIMIT=1.25
AFFILIATE_MAPPER_MEMORY_LIMIT=4g
