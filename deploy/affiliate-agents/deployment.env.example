AFFILIATE_MAPPER_MEMORY_SWAP_LIMIT=4g
AFFILIATE_MAPPER_PIDS_LIMIT=512

AFFILIATE_REVIEWER_CPU_LIMIT=1.0
AFFILIATE_REVIEWER_MEMORY_LIMIT=2g
AFFILIATE_REVIEWER_MEMORY_RESERVATION=512m
AFFILIATE_REVIEWER_MEMORY_SWAP_LIMIT=2g
AFFILIATE_REVIEWER_PIDS_LIMIT=512

AFFILIATE_COVERAGE_CPU_LIMIT=1.0
