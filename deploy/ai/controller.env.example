# Trusted-controller secrets only. Copy to controller.env, fill it on the VM,
# and chmod 0600. This file is never passed to the model service.
DATABASE_URL=
DATABASE_URL_LIVE=
PG_SSL_REJECT_UNAUTHORIZED=false
STORAGE_PROVIDER=spaces
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=

# Keep disabled until a dry-run source or queue mode is intentionally selected.
# disabled: refuse to start
# dry-run: no queue claim; AFFILIATE_MAPPING_DRY_RUN_SOURCE_KEY is required
# queue: claim one live READY_FOR_MAPPING job and stop at REVIEW_REQUIRED
AFFILIATE_MAPPING_DRY_RUN_SOURCE_KEY=
AFFILIATE_MAPPING_WORKER_ID=ovh-affiliate-open-weight
AFFILIATE_MAPPING_REVIEW_SCRAPE=false
AFFILIATE_MAPPING_MODEL_TIMEOUT_MS=5400000
